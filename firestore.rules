rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAccount() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function activeManager(orgId) {
      return signedInAccount()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'MANAGER'
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.active == true;
    }

    function hasValidChecklistContextRevision(data) {
      return !('checklistContextRevision' in data)
        || (data.checklistContextRevision is int && data.checklistContextRevision >= 0);
    }

    function checklistContextRevision(data) {
      return ('checklistContextRevision' in data
        && data.checklistContextRevision is int
        && data.checklistContextRevision >= 0)
        ? data.checklistContextRevision
        : 0;
    }

    function checklistEligibleExecutionState(data) {
      return 'operationalStatus' in data
        && data.operationalStatus in ['ASSIGNED', 'IN_PROGRESS'];
    }

    function jobChecklistContextChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'archivedAt',
          'propertyId',
          'scheduledDate',
          'scheduledStart',
          'assignedCleanerId',
          'assignedCleanerIds',
        ])
        || checklistEligibleExecutionState(request.resource.data)
          != checklistEligibleExecutionState(resource.data);
    }

    // Browser clients may preserve a Job revision, but context changes must
    // advance it exactly once. Server-only checklist namespaces remain denied.
    function validJobChecklistContextRevisionCreate() {
      return hasValidChecklistContextRevision(request.resource.data)
        && (!('scheduleRevision' in request.resource.data)
          || (request.resource.data.scheduleRevision is int
            && request.resource.data.scheduleRevision == 0))
        && (!('checklistContextRevision' in request.resource.data)
          || checklistContextRevision(request.resource.data) == 0);
    }

    function validRequiredCleanerCountCreate() {
      return ('schemaVersion' in request.resource.data
          && request.resource.data.schemaVersion is int
          && request.resource.data.schemaVersion >= 2)
        ? ('requiredCleanerCount' in request.resource.data
          && request.resource.data.requiredCleanerCount is int
          && request.resource.data.requiredCleanerCount >= 1
          && request.resource.data.requiredCleanerCount <= 4)
        : (!('requiredCleanerCount' in request.resource.data)
          || (request.resource.data.requiredCleanerCount is int
            && request.resource.data.requiredCleanerCount == 1));
    }

    function validJobChecklistContextRevisionUpdate() {
      return hasValidChecklistContextRevision(request.resource.data)
        && (jobChecklistContextChanged()
          ? ('checklistContextRevision' in request.resource.data
            && checklistContextRevision(request.resource.data)
              == checklistContextRevision(resource.data) + 1)
          : !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['checklistContextRevision']));
    }

    function jobScheduleUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['scheduledDate', 'scheduledStart', 'scheduleRevision']);
    }

    function jobTeamFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['requiredCleanerCount', 'assignedCleanerIds', 'schemaVersion']);
    }

    function jobCannotStartFromBrowser() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['operationalStatus'])
        || request.resource.data.operationalStatus != 'IN_PROGRESS';
    }

    function validManagerPageLoadConnection(data) {
      return !('connection' in data)
        || (data.connection is map
          && data.connection.keys().hasOnly(['effectiveType', 'rtt', 'downlink', 'saveData'])
          && (!('effectiveType' in data.connection)
            || (data.connection.effectiveType is string && data.connection.effectiveType.size() <= 16))
          && (!('rtt' in data.connection)
            || (data.connection.rtt is number && data.connection.rtt >= 0 && data.connection.rtt <= 100000))
          && (!('downlink' in data.connection)
            || (data.connection.downlink is number && data.connection.downlink >= 0 && data.connection.downlink <= 100000))
          && (!('saveData' in data.connection) || data.connection.saveData is bool));
    }

    function validManagerPageLoadEvent(data) {
      return data.keys().hasOnly([
          'page', 'durationMs', 'dataDurationMs', 'result', 'uid', 'sessionId', 'deviceId',
          'deviceClass', 'browser', 'platform', 'standalone', 'connection', 'viewport',
          'appVersion', 'createdAt',
        ])
        && data.keys().hasAll([
          'page', 'durationMs', 'dataDurationMs', 'result', 'uid', 'sessionId', 'deviceId',
          'deviceClass', 'browser', 'platform', 'standalone', 'viewport', 'appVersion', 'createdAt',
        ])
        && data.page in ['dashboard', 'jobs', 'properties', 'clients', 'cleaners', 'payouts']
        && data.durationMs is int && data.durationMs >= 0 && data.durationMs <= 600000
        && data.dataDurationMs is int && data.dataDurationMs >= 0 && data.dataDurationMs <= 600000
        && data.result in ['success', 'error']
        && data.uid == request.auth.uid
        && data.sessionId is string && data.sessionId.size() > 0 && data.sessionId.size() <= 128
        && data.deviceId is string && data.deviceId.size() > 0 && data.deviceId.size() <= 128
        && data.deviceClass in ['mobile', 'desktop']
        && data.browser in ['chrome', 'safari', 'firefox', 'edge', 'other']
        && data.platform in ['ios', 'android', 'macos', 'windows', 'linux', 'other']
        && data.standalone is bool
        && data.viewport is map
        && data.viewport.keys().hasOnly(['width', 'height'])
        && data.viewport.keys().hasAll(['width', 'height'])
        && data.viewport.width is int && data.viewport.width >= 0 && data.viewport.width <= 10000
        && data.viewport.height is int && data.viewport.height >= 0 && data.viewport.height <= 10000
        && data.appVersion is string && data.appVersion.size() > 0 && data.appVersion.size() <= 50
        && data.createdAt == request.time
        && validManagerPageLoadConnection(data);
    }

    match /organizations/{orgId} {
      // Membership is provisioned by trusted administrators, never by browser clients.
      match /members/{uid} {
        allow get: if signedInAccount() && request.auth.uid == uid;
      }

      // Authorized managers may inspect bounded page-load diagnostics; only validated client events can be appended.
      match /managerPageLoadEvents/{eventId} {
        allow read: if activeManager(orgId);
        allow create: if activeManager(orgId) && validManagerPageLoadEvent(request.resource.data);
      }

      // Exact document depths are intentional: new subcollections do not inherit access.
      match /{collectionName}/{recordId} {
        allow read, delete: if collectionName in ['clients', 'properties', 'cleaners', 'jobs', 'payouts']
          && activeManager(orgId);
        allow create: if collectionName in ['clients', 'properties', 'cleaners', 'payouts']
          && activeManager(orgId)
          || (collectionName == 'jobs'
            && activeManager(orgId)
            && validJobChecklistContextRevisionCreate()
            && validRequiredCleanerCountCreate());
        allow update: if collectionName in ['clients', 'properties', 'cleaners', 'payouts']
          && activeManager(orgId)
          || (collectionName == 'jobs'
            && activeManager(orgId)
            && jobScheduleUnchanged()
            && jobTeamFieldsUnchanged()
            && jobCannotStartFromBrowser()
            && validJobChecklistContextRevisionUpdate());
      }

      match /jobs/{jobId}/{collectionName}/{recordId} {
        allow read: if collectionName in ['offers', 'assignments', 'issues']
          && activeManager(orgId);
        allow create, update, delete: if collectionName in ['offers', 'issues']
          && activeManager(orgId);
      }

      match /jobs/{jobId}/assignments/{assignmentId} {
        // Roster writes must go through manager-authorized transactional Functions.
        allow create, update, delete: if false;
      }
    }

    // Includes reminder/device metadata and all future checklist/settings/evidence paths.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
