# Copy locally to ignored .env.sandbox.local only after a dedicated project exists.
# Do not use production values. Blank configuration intentionally fails closed.
VITE_CLEANFLOW_ENV=sandbox
VITE_CLEANFLOW_SANDBOX_PROJECT_ID=
VITE_CLEANFLOW_SANDBOX_ORIGIN=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Never inherit the frozen production OneSignal app or production push key.
VITE_ONESIGNAL_APP_ID=
VITE_FIREBASE_VAPID_KEY=
