{
  "name": "cleanflow",
  "private": true,
  "version": "0.9.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:emulators": "VITE_USE_FIREBASE_EMULATORS=true vite build --mode emulator",
    "preview": "vite preview",
    "test": "vitest run",
