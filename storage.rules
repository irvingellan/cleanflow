rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // The current development authorization model treats authenticated users as managers
    // for cleanflow-demo. Future organization membership/roles must narrow this rule.
    match /organizations/cleanflow-demo/payouts/{payoutId}/proof/payment-proof {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          "image/jpeg",
          "image/png",
          "image/webp",
          "image/heic",
          "image/heif"
        ];
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
