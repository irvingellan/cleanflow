{
  "name": "cleanflow-notification-lab",
  "private": true,
  "version": "1.0.0",
  "description": "CleanFlow Notification Lab V1 — offline, fully simulated notification scenarios (no Firebase, no real push).",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5317 --strictPort",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5318 --strictPort",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "evidence": "playwright test e2e/evidence.spec.ts"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "28.1.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
