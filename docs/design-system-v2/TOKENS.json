{
  "$meta": {
    "name": "CleanFlow Design System V2",
    "version": "2.0.0-design",
    "date": "2026-10-06",
    "status": "Design reference. Implementation-neutral. Not production CSS.",
    "units": "Colors are sRGB hex. Sizes are CSS px. Letter spacing is em. Durations are ms.",
    "themes": ["light", "dark"],
    "note": "Every colour is a role with one value per theme. Components reference roles, never hex values."
  },

  "color": {
    "light": {
      "canvas": "#f4f7f5",
      "surface": "#ffffff",
      "surface-subtle": "#f8faf9",
      "surface-elevated": "#ffffff",
      "surface-selected": "#eef5f1",
      "surface-sunken": "#edf3f0",
      "surface-internal": "#f3f4f6",
      "text-primary": "#17251f",
      "text-secondary": "#52645b",
      "text-muted": "#647069",
      "text-disabled": "#98a39d",
      "border": "#dce5e0",
      "border-strong": "#b8c9c1",
      "border-input": "#84978d",
      "border-selected": "#7fa792",
      "divider": "#e7edea",
      "brand": "#315c49",
      "brand-hover": "#274b3b",
      "brand-text": "#35594a",
      "on-brand": "#ffffff",
      "focus": "#3f705b",
      "info-bg": "#eef3f7", "info-border": "#cddbe6", "info-text": "#3b566b",
      "attention-bg": "#fff6e6", "attention-border": "#ecd6a8", "attention-text": "#6f501d",
      "warning-bg": "#fdf3ea", "warning-border": "#efcfb2", "warning-text": "#8f4a1c",
      "risk-bg": "#fdf4f2", "risk-border": "#e6c5be", "risk-text": "#8a3a2c",
      "success-bg": "#eef5f1", "success-border": "#c5dccf", "success-text": "#2f6048",
      "sandbox-bg": "#edf3f0", "sandbox-border": "#9db5a9", "sandbox-text": "#35594a",
      "scrim": "rgb(23 37 31 / 42%)"
    },
    "dark": {
      "canvas": "#171a1c",
      "surface": "#202427",
      "surface-subtle": "#262b2e",
      "surface-elevated": "#2a2f33",
      "surface-selected": "#2b3931",
      "surface-sunken": "#2b3235",
      "surface-internal": "#23262b",
      "text-primary": "#f0f3f1",
      "text-secondary": "#c5cdca",
      "text-muted": "#a3adaa",
      "text-disabled": "#6f7976",
      "border": "#3c4346",
      "border-strong": "#4c5457",
      "border-input": "#6f797c",
      "border-selected": "#6a9c7b",
      "divider": "#343b3e",
      "brand": "#8cba9e",
      "brand-hover": "#a0c9b0",
      "brand-text": "#b2d2be",
      "on-brand": "#10261a",
      "focus": "#9dc9ad",
      "info-bg": "#25323b", "info-border": "#3e5364", "info-text": "#a9cbe0",
      "attention-bg": "#423719", "attention-border": "#6b5a2a", "attention-text": "#ffd989",
      "warning-bg": "#3d2e22", "warning-border": "#6b4c35", "warning-text": "#f6b98c",
      "risk-bg": "#3b2b2b", "risk-border": "#754d47", "risk-text": "#ffb5a9",
      "success-bg": "#2b3931", "success-border": "#44604f", "success-text": "#93c7a7",
      "sandbox-bg": "#2b3530", "sandbox-border": "#5b7566", "sandbox-text": "#b2d2be",
      "scrim": "rgb(0 0 0 / 58%)"
    }
  },

  "state": {
    "$note": "A state is always icon + text + colour. Tone names map to the colour triplets above.",
    "neutral":   { "tone": "surface-sunken / border / text-secondary", "meaning": "Nothing to decide", "icon": "minus-circle or domain icon" },
    "selected":  { "tone": "surface-selected / border-selected / brand-text", "meaning": "Current item, active filter, current lifecycle stage", "icon": "none; inset 3px brand bar on rows" },
    "info":      { "tone": "info", "meaning": "Waiting on someone else; no action yet", "icon": "send, clock, info" },
    "attention": { "tone": "attention", "meaning": "Something changed; compare and decide", "icon": "alert-circle, user-check, clipboard-check" },
    "warning":   { "tone": "warning", "meaning": "Blocked until the manager gives input", "icon": "alert-triangle, user-x" },
    "risk":      { "tone": "risk", "meaning": "A reported problem or a destructive action", "icon": "alert-triangle" },
    "success":   { "tone": "success", "meaning": "Healthy or finished", "icon": "check" },
    "confirmed": { "tone": "success", "meaning": "Confirmed by a person", "icon": "check-circle" },
    "disabled":  { "tone": "surface-sunken / border / text-disabled", "meaning": "Not available; prefer 'blocked' with a reason", "icon": "none" },
    "blocked":   { "tone": "transparent / border-strong dashed / text-secondary", "meaning": "Available after a named input", "icon": "lock" },
    "sandbox":   { "tone": "sandbox, dashed border", "meaning": "Test environment and test data", "icon": "flask" },
    "production":{ "tone": "transparent / border / text-muted", "meaning": "Live environment; shown in the account menu only", "icon": "none" }
  },

  "typography": {
    "font-family": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
    "font-family-mono": "ui-monospace, SFMono-Regular, Menlo, monospace",
    "weights": [400, 500, 600, 700, 800],
    "display":       { "size": 40, "line": 44, "weight": 800, "tracking": -0.04 },
    "page-title":    { "size": 28, "line": 34, "weight": 800, "tracking": -0.032, "compact": { "size": 24, "line": 30, "tracking": -0.03 } },
    "section-title": { "size": 18, "line": 24, "weight": 700, "tracking": -0.015 },
    "card-title":    { "size": 16, "line": 22, "weight": 700, "tracking": -0.01 },
    "body-strong":   { "size": 15, "line": 22, "weight": 600, "tracking": 0 },
    "body":          { "size": 15, "line": 22, "weight": 400, "tracking": 0 },
    "secondary":     { "size": 14, "line": 20, "weight": 400, "tracking": 0, "color": "text-secondary" },
    "metadata":      { "size": 13, "line": 18, "weight": 500, "tracking": 0, "color": "text-secondary" },
    "micro-label":   { "size": 11, "line": 14, "weight": 700, "tracking": 0.08, "transform": "uppercase", "color": "text-muted" },
    "numeric-kpi":   { "size": 28, "line": 32, "weight": 800, "tracking": -0.03, "numeric": "tabular-nums", "compact": { "size": 22, "line": 26 } },
    "button":        { "size": 15, "line": 20, "weight": 700, "tracking": 0, "small": { "size": 13, "line": 18 }, "large": { "size": 16, "line": 22 } }
  },

  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "hairline": 2 },

  "radius": { "tag": 6, "small": 10, "control": 12, "card": 14, "panel": 18, "sheet": 22, "pill": 999 },

  "size": {
    "touch-target-min": 44,
    "control": 44, "control-small": 36, "control-large": 52,
    "row-desktop-min": 56, "row-mobile-min": 64, "attention-row-min": 76,
    "icon": 18, "icon-label": 14, "icon-tab": 22,
    "avatar": 28, "avatar-large": 40,
    "pill": 24, "tag": 20, "chip": 36,
    "border": 1, "focus-ring": 3, "focus-offset": 2,
    "lifecycle-segment": { "width": 20, "height": 6, "current-width": 24, "current-height": 10, "gap": 3 }
  },

  "layout": {
    "sidebar": 232, "sidebar-rail": 64,
    "content-max-standard": 1200, "content-max-wide": 1560, "content-max-form": 720,
    "split": { "queue-min": 360, "queue-max": 420, "decision-rail": 360 },
    "gutter": { "compact": 16, "medium": 24, "wide": 32 },
    "panel-gap": 24, "section-gap": 20,
    "mobile": { "tab-bar-height": 56, "safe-area-bottom": "env(safe-area-inset-bottom)", "sandbox-strip": 28, "tabs": 4 }
  },

  "breakpoint": {
    "compact": { "max": 719 },
    "medium": { "min": 720, "max": 1099 },
    "wide": { "min": 1100, "max": 1439 },
    "extra-wide": { "min": 1440 }
  },

  "elevation": {
    "$note": "Borders first. Shadow only on overlays: menus, dialogs, sheets, toasts.",
    "overlay": { "light": "0 12px 32px rgb(28 54 42 / 12%), 0 2px 6px rgb(28 54 42 / 6%)", "dark": "0 12px 32px rgb(0 0 0 / 40%), 0 2px 6px rgb(0 0 0 / 24%)" }
  },

  "motion": {
    "duration": { "fast": 120, "base": 180, "sheet": 240 },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)" },
    "reduced-motion": "No transforms, no shimmer. Opacity changes of 120 ms at most.",
    "slow-network-notice-after": 5000
  },

  "legacy-map": {
    "$note": "Current src/index.css custom property -> V2 role. Lets Phase A ship as aliases with no visual change.",
    "--color-page-bg": "canvas",
    "--color-surface": "surface",
    "--color-surface-subtle": "surface-subtle",
    "--color-text": "text-primary",
    "--color-heading": "text-primary",
    "--color-text-secondary": "text-secondary",
    "--color-muted": "text-muted",
    "--color-text-support": "text-muted",
    "--color-readonly-text": "text-muted",
    "--color-brand": "brand",
    "--color-brand-text": "brand-text",
    "--color-button-text": "brand-text",
    "--color-brand-muted": "brand-text",
    "--color-on-brand": "on-brand",
    "--color-success": "success-text",
    "--color-focus": "focus",
    "--color-chart": "border-selected",
    "--color-warning-text": "attention-text",
    "--color-warning-label": "attention-text",
    "--color-status-warning-bg": "attention-bg",
    "--color-attention-bg": "attention-bg",
    "--color-urgent": "warning-text",
    "--color-error-text": "risk-text",
    "--color-alert-text": "risk-text",
    "--color-auth-error": "risk-text",
    "--color-error-bg": "risk-bg",
    "--color-error-border": "risk-border",
    "--color-border": "border",
    "--color-border-strong": "border-strong",
    "--color-input-border": "border-input",
    "--color-divider": "divider",
    "--color-nav-active": "surface-selected",
    "--color-selected-bg": "surface-selected",
    "--color-selected-border": "border-selected",
    "--color-badge-bg": "surface-sunken",
    "--color-status-dot": "(retired: the dot carried no meaning)"
  },

  "changed-from-current": {
    "$note": "Values that differ from today's src/index.css. Everything else is the same hex.",
    "text-muted": { "light": "#6a756f -> #647069 (4.4:1 -> 4.8:1 on canvas)", "dark": "#b9c1bd -> #a3adaa (restores a visible step below text-secondary)" },
    "border-input": { "light": "#cfdad4 -> #84978d (1.4:1 -> 3.1:1 on surface)", "dark": "#596164 -> #6f797c (2.5:1 -> 3.5:1)" },
    "brand-text": { "light": "#3d5b4e -> #35594a" },
    "surface-subtle": { "dark": "#292e31 -> #262b2e" },
    "surface-sunken": { "dark": "#2b3530 -> #2b3235" },
    "divider": { "light": "#e3eae6 -> #e7edea", "dark": "#383f42 -> #343b3e" },
    "risk-border": { "light": "#dfc9c4 -> #e6c5be" },
    "new-roles": ["surface-elevated", "surface-internal", "text-disabled", "brand-hover", "info-*", "warning-bg", "warning-border", "attention-border", "success-bg", "success-border", "sandbox-*", "scrim"]
  }
}
