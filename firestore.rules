rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAccount() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function activeManager(orgId) {
      return signedInAccount()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'MANAGER'
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.active == true;
    }

    function memberPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }

    function eligibleCleaner(orgId, cleanerId) {
      let cleaner = get(/databases/$(database)/documents/organizations/$(orgId)/cleaners/$(cleanerId)).data;
      return cleaner.active == true && cleaner.get('archivedAt', null) == null;
    }

    // Cleaner Hub: a CLEANER membership is server-provisioned by a single-use
    // access code and authorizes only explicitly active sessions.
    function activeCleaner(orgId) {
      return signedInAccount()
        && request.auth.token.cleanerHub is map
        && exists(memberPath(orgId))
        && get(memberPath(orgId)).data.role == 'CLEANER'
        && get(memberPath(orgId)).data.active == true
        && get(memberPath(orgId)).data.organizationId == orgId
        && request.auth.token.cleanerHub.organizationId == orgId
        && get(memberPath(orgId)).data.cleanerId is string
        && request.auth.token.cleanerHub.cleanerId == get(memberPath(orgId)).data.cleanerId
        && request.auth.token.cleanerHub.sessionId is string
        && request.auth.token.cleanerHub.sessionId.size() > 0
        && request.auth.token.cleanerHub.sessionId in get(memberPath(orgId)).data.get(
          'sessionIds', [get(memberPath(orgId)).data.get('sessionId', '')])
        && eligibleCleaner(orgId, get(memberPath(orgId)).data.cleanerId);
    }

    function hasValidChecklistContextRevision(data) {
      return !('checklistContextRevision' in data)
        || (data.checklistContextRevision is int && data.checklistContextRevision >= 0);
    }

    function checklistContextRevision(data) {
      return ('checklistContextRevision' in data
        && data.checklistContextRevision is int
        && data.checklistContextRevision >= 0)
        ? data.checklistContextRevision
        : 0;
    }

    function checklistEligibleExecutionState(data) {
      return 'operationalStatus' in data
        && data.operationalStatus in ['ASSIGNED', 'IN_PROGRESS'];
    }

    function jobChecklistContextChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'archivedAt',
          'propertyId',
          'scheduledDate',
          'scheduledStart',
          'assignedCleanerId',
          'assignedCleanerIds',
        ])
        || checklistEligibleExecutionState(request.resource.data)
          != checklistEligibleExecutionState(resource.data);
    }

    // Browser clients may preserve a Job revision, but context changes must
    // advance it exactly once. Server-only checklist namespaces remain denied.
    function validJobChecklistContextRevisionCreate() {
      return hasValidChecklistContextRevision(request.resource.data)
        && (!('scheduleRevision' in request.resource.data)
          || (request.resource.data.scheduleRevision is int
            && request.resource.data.scheduleRevision == 0))
        && (!('checklistContextRevision' in request.resource.data)
          || checklistContextRevision(request.resource.data) == 0);
    }

    function validJobChecklistContextRevisionUpdate() {
      return hasValidChecklistContextRevision(request.resource.data)
        && (jobChecklistContextChanged()
          ? ('checklistContextRevision' in request.resource.data
            && checklistContextRevision(request.resource.data)
              == checklistContextRevision(resource.data) + 1)
          : !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['checklistContextRevision']));
    }

    // Completion is a server-owned action, including Jobs without a Checklist Run.
    function browserJobDoesNotCreateCompletion() {
      return !('operationalStatus' in request.resource.data)
        || request.resource.data.operationalStatus != 'COMPLETED';
    }

    function browserJobKeepsCompletionState() {
      return ('operationalStatus' in request.resource.data
          && request.resource.data.operationalStatus == 'COMPLETED')
        == ('operationalStatus' in resource.data
          && resource.data.operationalStatus == 'COMPLETED');
    }

    function jobScheduleUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['scheduledDate', 'scheduledStart', 'scheduleRevision']);
    }

    function isAutomaticOfferJob(data) {
      return data.get('offerDistributionMode', null) == 'FIRST_ACCEPT_WINS';
    }

    function automaticOfferJob(orgId, jobId) {
      let path = /databases/$(database)/documents/organizations/$(orgId)/jobs/$(jobId);
      return exists(path) && isAutomaticOfferJob(get(path).data);
    }

    function browserJobKeepsAutomaticOfferProvenance() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'offerDistributionMode', 'offerDistributionByUid', 'firstAcceptClaim', 'offerDistributionClosedAt'
        ])
        && (!isAutomaticOfferJob(resource.data)
          || (request.resource.data.get('schemaVersion', 0) == 2
            && request.resource.data.get('organizationId', '') == resource.data.get('organizationId', '')
            && request.resource.data.get('requiredCleanerCount', 1) == resource.data.get('requiredCleanerCount', 1)
            && request.resource.data.get('assignedCleanerId', null) == resource.data.get('assignedCleanerId', null)
            && (request.resource.data.assignedCleanerIds == resource.data.assignedCleanerIds
              || request.resource.data.assignedCleanerIds == [])));
    }

    function managerCanUpdateAutomaticOffer(orgId, jobId) {
      let job = get(/databases/$(database)/documents/organizations/$(orgId)/jobs/$(jobId)).data;
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.get('offerDistributionMode', null) == 'FIRST_ACCEPT_WINS'
        && resource.data.status == 'PENDING'
        && resource.data.publicOfferExpiresAt > request.time
        && resource.data.offeredChecklistContextRevision == checklistContextRevision(job)
        && job.operationalStatus == 'OFFERED'
        && job.get('firstAcceptClaim', null) == null
        && job.get('offerDistributionClosedAt', null) == null
        && job.get('archivedAt', null) == null
        && ((changes.hasOnly(['publicOfferTokenHash'])
            && request.resource.data.publicOfferTokenHash is string
            && request.resource.data.publicOfferTokenHash.matches('^[a-f0-9]{64}$'))
          || (changes.hasOnly(['status', 'revokedAt'])
            && request.resource.data.status == 'REVOKED'
            && request.resource.data.revokedAt == request.time));
    }

    function assignmentParentRevisionAdvanced(orgId, jobId) {
      let jobPath = /databases/$(database)/documents/organizations/$(orgId)/jobs/$(jobId);
      return exists(jobPath)
        && getAfter(jobPath).data.checklistContextRevision is int
        && getAfter(jobPath).data.checklistContextRevision
          == checklistContextRevision(get(jobPath).data) + 1;
    }

    function assignmentCleanerContextChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['cleanerId', 'isActive']);
    }

    function validManagerPageLoadConnection(data) {
      return !('connection' in data)
        || (data.connection is map
          && data.connection.keys().hasOnly(['effectiveType', 'rtt', 'downlink', 'saveData'])
          && (!('effectiveType' in data.connection)
            || (data.connection.effectiveType is string && data.connection.effectiveType.size() <= 16))
          && (!('rtt' in data.connection)
            || (data.connection.rtt is number && data.connection.rtt >= 0 && data.connection.rtt <= 100000))
          && (!('downlink' in data.connection)
            || (data.connection.downlink is number && data.connection.downlink >= 0 && data.connection.downlink <= 100000))
          && (!('saveData' in data.connection) || data.connection.saveData is bool));
    }

    function validManagerPageLoadEvent(data) {
      return data.keys().hasOnly([
          'page', 'durationMs', 'dataDurationMs', 'result', 'uid', 'sessionId', 'deviceId',
          'deviceClass', 'browser', 'platform', 'standalone', 'connection', 'viewport',
          'appVersion', 'createdAt',
        ])
        && data.keys().hasAll([
          'page', 'durationMs', 'dataDurationMs', 'result', 'uid', 'sessionId', 'deviceId',
          'deviceClass', 'browser', 'platform', 'standalone', 'viewport', 'appVersion', 'createdAt',
        ])
        && data.page in ['dashboard', 'jobs', 'properties', 'clients', 'cleaners', 'payouts']
        && data.durationMs is int && data.durationMs >= 0 && data.durationMs <= 600000
        && data.dataDurationMs is int && data.dataDurationMs >= 0 && data.dataDurationMs <= 600000
        && data.result in ['success', 'error']
        && data.uid == request.auth.uid
        && data.sessionId is string && data.sessionId.size() > 0 && data.sessionId.size() <= 128
        && data.deviceId is string && data.deviceId.size() > 0 && data.deviceId.size() <= 128
        && data.deviceClass in ['mobile', 'desktop']
        && data.browser in ['chrome', 'safari', 'firefox', 'edge', 'other']
        && data.platform in ['ios', 'android', 'macos', 'windows', 'linux', 'other']
        && data.standalone is bool
        && data.viewport is map
        && data.viewport.keys().hasOnly(['width', 'height'])
        && data.viewport.keys().hasAll(['width', 'height'])
        && data.viewport.width is int && data.viewport.width >= 0 && data.viewport.width <= 10000
        && data.viewport.height is int && data.viewport.height >= 0 && data.viewport.height <= 10000
        && data.appVersion is string && data.appVersion.size() > 0 && data.appVersion.size() <= 50
        && data.createdAt == request.time
        && validManagerPageLoadConnection(data);
    }

    function validManagerOperationEvent(data) {
      return data.keys().hasOnly([
          'page', 'operation', 'phase', 'result', 'uid', 'pageVisitId',
          'startedAtMs', 'durationMs', 'sessionId', 'deviceId', 'deviceClass',
          'browser', 'platform', 'standalone', 'viewport', 'connection',
          'appVersion', 'createdAt',
        ])
        && data.keys().hasAll([
          'page', 'operation', 'phase', 'result', 'uid', 'pageVisitId',
          'startedAtMs', 'durationMs', 'sessionId', 'deviceId', 'deviceClass',
          'browser', 'platform', 'standalone', 'viewport', 'appVersion', 'createdAt',
        ])
        && data.page == 'job-detail'
        && data.operation in [
          'offers', 'issues', 'assignments', 'checklist-run',
          'checklist-capability', 'cleaners',
        ]
        && data.phase in ['initial', 'refresh']
        && data.result in ['success', 'error']
        && data.uid == request.auth.uid
        && data.pageVisitId is string
        && data.pageVisitId.matches('^[A-Za-z0-9]{8,16}-[A-Za-z0-9-]{7,47}$')
        && data.startedAtMs is int
        && data.startedAtMs >= 1577836800000 && data.startedAtMs <= 4102444800000
        && data.durationMs is int && data.durationMs >= 0 && data.durationMs <= 600000
        && data.sessionId is string && data.sessionId.size() > 0 && data.sessionId.size() <= 128
        && data.deviceId is string && data.deviceId.size() > 0 && data.deviceId.size() <= 128
        && data.deviceClass in ['mobile', 'desktop']
        && data.browser in ['chrome', 'safari', 'firefox', 'edge', 'other']
        && data.platform in ['ios', 'android', 'macos', 'windows', 'linux', 'other']
        && data.standalone is bool
        && data.viewport is map
        && data.viewport.keys().hasOnly(['width', 'height'])
        && data.viewport.keys().hasAll(['width', 'height'])
        && data.viewport.width is int && data.viewport.width >= 0 && data.viewport.width <= 10000
        && data.viewport.height is int && data.viewport.height >= 0 && data.viewport.height <= 10000
        && data.appVersion is string && data.appVersion.matches('^[A-Za-z0-9._+-]{1,50}$')
        && data.createdAt == request.time
        && validManagerPageLoadConnection(data);
    }

    match /organizations/{orgId} {
      // Membership is provisioned by trusted administrators, never by browser clients.
      match /members/{uid} {
        allow get: if signedInAccount() && request.auth.uid == uid
          && (!exists(memberPath(orgId)) || resource.data.get('role', null) != 'CLEANER' || activeCleaner(orgId));
      }

      // Server-written, cleaner-safe agenda projection. Each cleaner reads only
      // entries for her own linked Cleaner record; nobody writes from a browser.
      match /cleanerAgenda/{entryId} {
        allow read: if activeCleaner(orgId)
          && resource.data.cleanerId == get(memberPath(orgId)).data.cleanerId;
      }

      // Server-written link status for the manager's Cleaner detail; never holds codes.
      match /cleanerHubAccess/{cleanerId} {
        allow read: if activeManager(orgId);
      }

      // Authorized managers may inspect bounded page-load diagnostics; only validated client events can be appended.
      match /managerPageLoadEvents/{eventId} {
        allow read: if activeManager(orgId);
        allow create: if activeManager(orgId) && validManagerPageLoadEvent(request.resource.data);
      }

      // Append-only, customer-data-free diagnostics for Job-detail operations.
      match /managerOperationEvents/{eventId} {
        allow read: if activeManager(orgId);
        allow create: if activeManager(orgId) && validManagerOperationEvent(request.resource.data);
      }

      // Exact document depths are intentional: new subcollections do not inherit access.
      match /{collectionName}/{recordId} {
        allow read: if collectionName in ['clients', 'properties', 'cleaners', 'jobs', 'payouts']
          && activeManager(orgId);
        allow delete: if collectionName in ['clients', 'properties', 'cleaners', 'jobs', 'payouts']
          && activeManager(orgId) && (collectionName != 'jobs' || !isAutomaticOfferJob(resource.data));
        allow create: if collectionName in ['clients', 'properties', 'cleaners', 'payouts']
          && activeManager(orgId)
          || (collectionName == 'jobs'
            && activeManager(orgId)
            && validJobChecklistContextRevisionCreate()
            && browserJobDoesNotCreateCompletion()
            && !request.resource.data.keys().hasAny([
              'offerDistributionMode', 'offerDistributionByUid', 'firstAcceptClaim', 'offerDistributionClosedAt'
            ])
            && !('completedAt' in request.resource.data));
        allow update: if collectionName in ['clients', 'properties', 'cleaners', 'payouts']
          && activeManager(orgId)
          || (collectionName == 'jobs'
            && activeManager(orgId)
            && jobScheduleUnchanged()
            && validJobChecklistContextRevisionUpdate()
            && browserJobKeepsCompletionState()
            && browserJobKeepsAutomaticOfferProvenance()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['completedAt']));
      }

      match /jobs/{jobId}/{collectionName}/{recordId} {
        allow read: if collectionName in ['offers', 'assignments', 'issues']
          && activeManager(orgId);
        allow create, update, delete: if collectionName == 'issues' && activeManager(orgId);
      }

      match /jobs/{jobId}/offers/{offerId} {
        allow create: if activeManager(orgId) && !automaticOfferJob(orgId, jobId)
          && request.resource.data.get('status', null) != 'ACCEPTED'
          && !request.resource.data.keys().hasAny(['offerDistributionMode', 'offeredChecklistContextRevision']);
        allow update: if activeManager(orgId) && (automaticOfferJob(orgId, jobId)
          ? managerCanUpdateAutomaticOffer(orgId, jobId)
          : (request.resource.data.get('status', null) != 'ACCEPTED'
            && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['offerDistributionMode', 'offeredChecklistContextRevision'])));
        allow delete: if activeManager(orgId) && !automaticOfferJob(orgId, jobId);
      }

      match /jobs/{jobId}/assignments/{assignmentId} {
        // Attendance acknowledgment is server-owned, independent of roster edits.
        allow create: if activeManager(orgId) && !automaticOfferJob(orgId, jobId)
          && !request.resource.data.keys()
            .hasAny(['cleanerAcknowledgedAt', 'cleanerAcknowledgedOfferId', 'assignmentMethod'])
          && assignmentParentRevisionAdvanced(orgId, jobId);
        allow delete: if activeManager(orgId) && !automaticOfferJob(orgId, jobId)
          && assignmentParentRevisionAdvanced(orgId, jobId);
        allow update: if activeManager(orgId)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['cleanerAcknowledgedAt', 'cleanerAcknowledgedOfferId', 'assignmentMethod'])
          && (!automaticOfferJob(orgId, jobId)
            || (resource.data.isActive == true && request.resource.data.isActive == false
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['isActive', 'removedAt', 'removedByUid'])))
          && (!assignmentCleanerContextChanged()
            || assignmentParentRevisionAdvanced(orgId, jobId));
      }
    }

    // Includes reminder/device metadata and all future checklist/settings/evidence paths.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
