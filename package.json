    "seed:properties": "node scripts/seedProperties.js",
    "seed:cleaners": "node scripts/seedCleaners.js",
    "seed:dashboard": "node scripts/seedDashboard.js",
    "seed:public-offer-emulator": "npm --prefix functions run seed:public-offer-emulator"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^28.1.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
