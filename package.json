{
  "name": "cleanflow",
  "private": true,
  "version": "0.9.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:emulators": "VITE_USE_FIREBASE_EMULATORS=true vite build --mode emulator",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "firebase emulators:exec --project demo-cleanflow --only auth,firestore \"playwright test\"",
    "test:all": "npm test && npm run test:e2e",
    "visual:env": "npm run build:emulators",
    "visual:fixtures": "node scripts/visual-smoke/seedE2eFixtures.mjs",
    "visual:smoke": "node scripts/visual-smoke/prepareAgentBrowser.mjs",
    "visual:clean": "node scripts/visual-smoke/cleanArtifacts.mjs",
    "seed:properties": "node scripts/seedProperties.js",
    "seed:cleaners": "node scripts/seedCleaners.js",
    "seed:dashboard": "node scripts/seedDashboard.js",
    "seed:public-offer-emulator": "npm --prefix functions run seed:public-offer-emulator"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-react": "^6.1.0",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.28.1",
    "jsdom": "^28.1.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
