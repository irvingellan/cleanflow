# Copy to .env.sandbox only after the dedicated Firebase Sandbox project exists.
# Never point these values at clean-flow-prototipo.
VITE_CLEANFLOW_ENV=sandbox
VITE_CLEANFLOW_SANDBOX_PROJECT_ID=REPLACE_WITH_SANDBOX_PROJECT_ID
VITE_CLEANFLOW_SANDBOX_ORIGIN=https://REPLACE_WITH_SANDBOX_PROJECT_ID.web.app
VITE_CLEANFLOW_PRODUCTION_ORIGIN=https://clean-flow-prototipo.web.app

VITE_FIREBASE_API_KEY=REPLACE_FROM_SANDBOX_WEB_APP
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_SANDBOX_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_SANDBOX_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_FROM_SANDBOX_WEB_APP
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_FROM_SANDBOX_WEB_APP
VITE_FIREBASE_APP_ID=REPLACE_FROM_SANDBOX_WEB_APP
